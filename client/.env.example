# in dev the client calls /api and vite proxies it to the go server (see vite.config.ts),
# so nothing here is needed to run locally

# where vite's /api proxy sends requests, if the go server isn't on 8080
# API_PROXY_TARGET="http://localhost:8080"

# the api's full url, for a production build that isn't served behind the same /api path
# VITE_API_URL="https://api.example.com"
