# sqlite database file, created on first run
DB_URL="./thisorthat.db"

# "dev" turns on POST /lists, POST /characters and POST /reset. anything else, like "prod", keeps them off
PLATFORM="dev"

# defaults to 8080
PORT="8080"

# only when running behind a reverse proxy or load balancer: comma separated ips or cidrs
# allowed to report the client's real ip, which the vote rate limit is keyed on
# TRUSTED_PROXIES="127.0.0.1"
